{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://127.0.0.1:15000"
      }
    },
    "Limits": {
      "MaxRequestBodySize": 10485760,
      "MaxRequestHeaderCount": 64,
      "RequestHeadersTimeout": "00:00:10"
    }
  },
  "ProxySecurity": {
    "AllowedHosts": [
      "appdynamic.es",
      "www.appdynamic.es",
      "localhost",
      "127.0.0.1"
    ],
    "ApiRateLimit": {
      "PermitLimit": 120,
      "WindowSeconds": 60
    }
  },
  "ReverseProxy": {
    "Routes": {
      "dynamic-api-root": {
        "ClusterId": "dynamic-api",
        "RateLimiterPolicy": "ApiLimiter",
        "Match": {
          "Path": "/Api"
        },
        "Transforms": [
          {
            "PathSet": "/api"
          }
        ]
      },
      "dynamic-api-media": {
        "ClusterId": "dynamic-api",
        "RateLimiterPolicy": "ApiLimiter",
        "Order": -100,
        "Match": {
          "Path": "/Api/negocios-media/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/negocios-media/{**catch-all}"
          }
        ]
      },
      "dynamic-public-media": {
        "ClusterId": "dynamic-api",
        "RateLimiterPolicy": "ApiLimiter",
        "Order": -100,
        "Match": {
          "Path": "/negocios-media/{**catch-all}"
        }
      },
      "dynamic-api": {
        "ClusterId": "dynamic-api",
        "RateLimiterPolicy": "ApiLimiter",
        "Match": {
          "Path": "/Api/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{**catch-all}"
          }
        ]
      },
      "spa-cdn": {
        "ClusterId": "spa-cdn",
        "Match": {
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "dynamic-api": {
        "HttpRequest": {
          "Version": "1.1",
          "VersionPolicy": "RequestVersionOrLower"
        },
        "Destinations": {
          "api": {
            "Address": "http://127.0.0.1:16000/"
          }
        }
      },
      "spa-cdn": {
        "HttpRequest": {
          "Version": "2",
          "VersionPolicy": "RequestVersionOrLower"
        },
        "Destinations": {
          "cdn": {
            "Address": "https://www.cdn.appdynamic.es/"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "appdynamic.es;www.appdynamic.es;localhost;127.0.0.1"
}
