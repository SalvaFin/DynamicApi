# .NET 10 / Visual Studio .gitignore
# Build results
bin/
obj/
artifacts/
**/artifacts/

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

# Visual Studio Code
.vscode/

# Rider
.idea/
*.sln.iml

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet
*.nupkg
# The packages folder can be ignored if you use package restore
**/packages/*
!**/packages/build/
!**/packages/repositories.config

# Microsoft Azure Web App publish settings
*.PublishSettings

# Windows image file caches
Thumbs.db

# Folder config file
Desktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# VS Code directory
.vscode/

# Local history for Visual Studio
.localhistory/

# Windows crash dumps
*.stackdump

# IIS Express
/.vs/

# Resharper
*.DotSettings.user

# DotCover
*.dotCover

# NCrunch
*.ncrunch*
_NCrunch_*

# MSTest test Results
TestResults/

# Build Results of VS2019+
out/

# JetBrains Rider
.idea/

# Backup & Report files from converting an old project
_UpgradeReport_Files/
Backup*/
UpgradeLog*.XML

# Publish Web Output
*.Publish.xml
*.pubxml
*.publishproj

# npm Packages
node_modules/

# dotenv environment variables
.env
.env.*
!.env.example

# Local app configuration with secrets
**/appsettings.Local.json
**/appsettings.*.local.json
**/appsettings.Secrets.json

# Python virtual environments
.venv/

# macOS
.DS_Store

# Windows
Thumbs.db
Desktop.ini

# Others
*.log
*.vspscc
*.vssscc
