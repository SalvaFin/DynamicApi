{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=dynamic_api;User=root;Password=change_me;Allow User Variables=true;TreatTinyAsBoolean=true"
  },
  "DynamicUsersDatabase": {
    "ConnectionStringName": "DefaultConnection",
    "MariaDbVersion": "11.4.0"
  },
  "Jwt": {
    "Issuer": "DynamicApi",
    "Audience": "DynamicApi.Clients",
